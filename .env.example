# Apex Health SNF Platform — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ─── AI Keys (backend only — never in the browser) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Backend / API ────────────────────────────────────────────────────────────
# URL of the FastAPI backend, used by the Next.js API route proxy
BACKEND_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/apex_health
# Or for SQLite during local dev:
# DATABASE_URL=sqlite:///./apex_health.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── Optional integrations ────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...        # If adding OpenAI fallback
# REDIS_URL=redis://localhost:6379  # For job queue (future)
